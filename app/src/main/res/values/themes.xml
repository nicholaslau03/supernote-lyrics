<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SupernoteLyrics" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/ink_white</item>
        <item name="android:textColorPrimary">@color/ink_black</item>
        <item name="android:textColorSecondary">@color/ink_gray</item>
        <item name="android:statusBarColor">@color/ink_white</item>
        <item name="android:navigationBarColor">@color/ink_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="MenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink_black</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
