<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ink_white">

        <!-- Source display -->
        <TextView
            android:id="@+id/sourceLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/ink_gray"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:text="@string/source_unknown" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ink_gray" />

        <!-- Safe display options -->
        <TextView
            android:id="@+id/menuSimplify"
            style="@style/MenuRow"
            android:text="@string/simplify_on" />

        <TextView
            android:id="@+id/menuSmaller"
            style="@style/MenuRow"
            android:text="@string/text_smaller" />

        <TextView
            android:id="@+id/menuLarger"
            style="@style/MenuRow"
            android:text="@string/text_larger" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/ink_gray" />

        <TextView
            android:id="@+id/menuSetupSpotify"
            style="@style/MenuRow"
            android:text="@string/setup_spotify_lyrics" />

        <!-- BIG SAFETY GAP before destructive actions -->
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ink_gray" />

        <!-- Destructive actions -->
        <TextView
            android:id="@+id/menuLogout"
            style="@style/MenuRow"
            android:text="@string/logout" />

        <TextView
            android:id="@+id/menuReset"
            style="@style/MenuRow"
            android:text="@string/reset_setup" />

        <TextView
            android:id="@+id/menuQuit"
            style="@style/MenuRow"
            android:text="@string/quit_app" />
    </LinearLayout>
</ScrollView>
